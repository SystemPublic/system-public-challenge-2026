  "cards": [
    {
      "dot": "emerald",
      "title": "Agents and runs",
      "items": [
        "Specialists: graph evidence, skeptic, policy / theory of change, EDA, indicator map, availability, research",
        "Data thread: the first pass and \"Data: topic\" runs use availability, indicator map, research and evidence; every chat thread reads them",
        "The profile (role, organisation, what you work on) goes into every planner, the dashboard and the report",
        "Product UI at /v2: accounts, settings, folders, chat-first tabs, select text and reply"
      ]
    },
    {
      "dot": "rose",
      "title": "Checks and verifier gates",
      "items": [
        "Every DOI, concept id, effect size and CI traced to tool results",
        "No causal wording; summary cites only DOIs from the sections",
        "Dashboard numbers must appear in tool results, or the panel is dropped",
        "Answers: major issues get one formatter fix pass",
        "Reports: major issues get one report writer revision",
        "Remaining issues are shown; a failed verifier labels the output not verified"
      ]
    },
    {
      "dot": "violet",
      "title": "Project knowledge graph",
      "items": [
        "Rebuilt in code after each done run from the stored answers",
        "Nodes: topics, concepts, indicators, places, populations, papers",
        "Facts carry qualifiers: effect, value, CI, verdict, population, DOI, run",
        "Thin coverage linked to OpenAlex and World Bank indicators",
        "Served at /api/projects/{id}/kg and as the project_graph MCP tool"
      ]
    },
    {
      "dot": "slate",
      "title": "Data sources and licences",
      "items": [
        "System Public Graph, cleaned Dataverse subset: CC BY-NC 4.0",
        "System Public Graph API: CC BY-NC 4.0",
        "OpenAlex: CC0",
        "PubMed E-utilities (NCBI): public; abstracts may be copyrighted",
        "World Bank Indicators and Data360: CC BY 4.0",
        "Web search results: linked, not checked against the graph"
      ]
    }
  ]
