  "cards": [
    {
      "dot": "emerald",
      "title": "Specialist agents",
      "items": [
        "Graph evidence: verdicts, consensus meters, DOIs",
        "Skeptic: contrary and null findings only",
        "Policy / theory of change: backed or unbacked links",
        "EDA: coverage, distributions, gaps",
        "Indicator map: evidence around a World Bank indicator",
        "Availability: where sources disagree or run out",
        "Research: OpenAlex, PubMed, web search"
      ]
    },
    {
      "dot": "rose",
      "title": "Checks in code",
      "items": [
        "Every DOI, concept id, effect size and CI traced to tool results",
        "Consensus meters match evidence summaries",
        "No causal wording",
        "Summary cites only DOIs from the sections",
        "Dashboard numbers must appear in tool results, or the panel is dropped",
        "A failed check goes back to the agent to retry"
      ]
    },
    {
      "dot": "slate",
      "title": "Data sources and licences",
      "items": [
        "System Public Graph, cleaned Dataverse subset: CC BY-NC 4.0",
        "System Public Graph API: CC BY-NC 4.0",
        "OpenAlex: CC0",
        "PubMed E-utilities (NCBI): public; abstracts may be copyrighted",
        "World Bank Indicators and Data360: CC BY 4.0",
        "Web search results: linked, not checked against the graph"
      ]
    }
  ]
