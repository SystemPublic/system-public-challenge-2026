n":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"System, Inc."},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"https://orcid.org/0000-0002-7367-4458","expandedvalue":{"personName":"Kang, David M.","@id":"https://orcid.org/0000-0002-7367-4458","scheme":"ORCID","@type":"https://schema.org/Person"}}},{"authorName":{"typeName":"authorName","multiple":false,"typeClass":"primitive","value":"Wedlock, Patrick"},"authorAffiliation":{"typeName":"authorAffiliation","multiple":false,"typeClass":"primitive","value":"System, Inc."},"authorIdentifierScheme":{"typeName":"authorIdentifierScheme","multiple":false,"typeClass":"controlledVocabulary","value":"ORCID"},"authorIdentifier":{"typeName":"authorIdentifier","multiple":false,"typeClass":"primitive","value":"https://orcid.org/0000-0001-7635-5949","expandedvalue":{"personName":"Wedlock, Patrick","@id":"https://orcid.org/0000-0001-7635-5949","scheme":"ORCID","@type":"https://schema.org/Person"}}}]},{"typeName":"datasetContact","multiple":true,"typeClass":"compound","value":[{"datasetContactName":{"typeName":"datasetContactName","multiple":false,"typeClass":"primitive","value":"James, Christine"},"datasetContactAffiliation":{"typeName":"datasetContactAffiliation","multiple":false,"typeClass":"primitive","value":"System, Inc."},"datasetContactEmail":{"typeName":"datasetContactEmail","multiple":false,"typeClass":"primitive","value":"public@system.com"}}]},{"typeName":"dsDescription","multiple":true,"typeClass":"compound","value":[{"dsDescriptionValue":{"typeName":"dsDescriptionValue","multiple":false,"typeClass":"primitive","value":"<p>The System Graph is a domain-agnostic, multi-scale graph with a scientifically-established finding as its atomic unit.</p>\n\n<p>Updated daily, using AI, and with a patented approach, the System Graph extracts, grounds, and links findings from verified sources like peer-reviewed studies and expert-curated databases.</p>\n\n<p>This generates millions of rich, quantitative relationships that cut across sources and fields from health, biology, climate, economics and beyond. It is a constantly growing, living representation of scientific knowledge.</p>\n\n<p>The System Public Graph is an annual static snapshot of a subset of the System Graph. Its contents are derived only from open, publicly available sources.</p>\n\n<p><i>The System Public Graph is made freely available for non-commercial use. It is designed to support researchers and developers across multiple disciplines, who need structured, machine-readable representations of scientific knowledge and relationships for analysis, modeling, and application development.</i></p>\n\n<p>The System Public Graph will soon be made available in other formats with more frequent updates: check <a href=\"https://www.system.com\">System.com</a> for updates.</p>\n\n<p>Documentation for the dataset:\n<ol>1:<a href=\"https://docs.system.com/system/public/overview\">Overview</a></ol>\n<ol>2: <a href=\"https://docs.system.com/system/public/quick-start-guide\">Quick-Start Guide</a></ol>\n<ol>3: <a href=\"https://docs.system.com/system/public/methods\">Methods</a></ol>\n<ol>4: <a href=\"https://docs.system.com/system/public/variable-grounding-logic\">Variable Grounding Logic</a></ol>\n<ol>5: <a href=\"https://docs.system.com/system/public/data-provenance\">Data Provenance</a></ol>\n<ol>6: <a href=\"https://docs.system.com/system/public/limitations-and-known-biases\">Limitations and Known Biases</a></ol>\n<ol>7: <a href=\"https://docs.system.com/system/public/data-dictionary\">Data Dictionary</a></ol>\n\n<p>This dataset is released under a CC-BY-NC 4.0 license. It is intended for non-commercial research and educational use.</p>"},"dsDescriptionDate":{"typeName":"dsDescriptionDate","multiple":false,"typeClass":"primitive","value":"2026-06-30"}}]},{"typeName":"subject","multiple":true,"typeClass":"controlledVocabulary","value":["Computer and Information Science","Earth and Environmental Sciences","Medicine, Health and Life Sciences","Social Sciences"]},{"typeName":"keyword","multiple":true,"typeClass":"compound","value":[{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"graph"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https://www.wikidata.org/wiki/Q141488"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Wikidata"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"https://www.wikidata.org/"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"open science"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https://www.wikidata.org/wiki/Q309823"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Wikidata"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"https://www.wikidata.org/"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"FAIR Data Principles"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https://www.wikidata.org/wiki/Q29032644"},"keywordVocabulary":{"typeName":"keywordVocabulary","multiple":false,"typeClass":"primitive","value":"Wikidata"},"keywordVocabularyURI":{"typeName":"keywordVocabularyURI","multiple":false,"typeClass":"primitive","value":"https://www.wikidata.org/"}},{"keywordValue":{"typeName":"keywordValue","multiple":false,"typeClass":"primitive","value":"linked data"},"keywordTermURI":{"typeName":"keywordTermURI","multiple":false,"typeClass":"primitive","value":"https: