"AS-S-FE": "Far-eastern South Asia",
"AS-SE-W": "Western Southeast Asia",
"AS-SE-E": "Eastern Southeast Asia",
"OC-NG": "Oceania (New Guinea)",
"SA": "South America"
},
"who_basis_note": "who_basis groups MalariaGEN population labels to match the wording of the WHO SP-resistance categories: East Africa and Northeast Africa as east_southern_africa; West and Central Africa as central_west_africa. This grouping is an approximation made for this project.",
"companions": "dhps_A581G and dhps_A437G are included because the WHO categories combine them with K540E; dhfr_dhps_quintuple is the WHO-validated haplotype that contains K540E.",
"interval_note": "No confidence intervals are stored. Compute a Wilson 95% interval from numerator and denominator."
},
