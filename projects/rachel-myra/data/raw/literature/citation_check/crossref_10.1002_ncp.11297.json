{"status":"ok","message-type":"work","message-version":"1.0.0","message":{"indexed":{"date-parts":[[2026,6,16]],"date-time":"2026-06-16T08:42:30Z","timestamp":1781599350859,"version":"3.54.5"},"reference-count":23,"publisher":"Wiley","issue":"5","license":[{"start":{"date-parts":[[2025,4,13]],"date-time":"2025-04-13T00:00:00Z","timestamp":1744502400000},"content-version":"vor","delay-in-days":0,"URL":"http:\/\/onlinelibrary.wiley.com\/termsAndConditions#vor"},{"start":{"date-parts":[[2025,4,13]],"date-time":"2025-04-13T00:00:00Z","timestamp":1744502400000},"content-version":"tdm","delay-in-days":0,"URL":"http:\/\/doi.wiley.com\/10.1002\/tdm_license_1.1"}],"content-domain":{"domain":["aspenjournals.onlinelibrary.wiley.com"],"crossmark-restriction":true},"short-container-title":["Nut in Clin Prac"],"published-print":{"date-parts":[[2025,10]]},"abstract":"<jats:title>Abstract<\/jats:title>\n                  <jats:p>Levodopa is competitively inhibited by amino acids for absorption across the intestinal wall and blood\u2010brain barrier. An acute withdrawal of levodopa increases the risk of Parkinsonism\u2010hyperpyrexia syndrome, a life\u2010threatening condition characterized by muscular rigidity, mental status changes, hyperthermia, and autonomic instability. This report discusses the case of a patient with Parkinson's disease who was critically ill who developed Parkinsonism\u2010hyperpyrexia syndrome while receiving enteral and parenteral nutrition support. Clinicians should be aware of this potential drug\u2010nutrient interaction when prescribing nutrition support to patients taking levodopa.<\/jats:p>","DOI":"10.1002\/ncp.11297","type":"journal-article","created":{"date-parts":[[2025,4,13]],"date-time":"2025-04-13T23:25:30Z","timestamp":1744586730000},"page":"1225-1229","update-policy":"https:\/\/doi.org\/10.1002\/crossmark_policy","source":"Crossref","is-referenced-by-count":2,"title":["Levodopa and nutrition support: A case report of Parkinsonism\u2010hyperpyrexia syndrome"],"prefix":"10.1002","volume":"40","author":[{"given":"Ryan","family":"Burslem","sequence":"first","affiliation":[{"name":"Department of Clinical Nutrition New York\u2010Presbyterian Hospital\/Weill Cornell Medical Center New York USA"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Liz","family":"Ramos","sequence":"additional","affiliation":[{"name":"Department of Pharmacy NewYork\u2010Presbyterian Hospital\/Weill Cornell Medical Center New York USA"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Chou","family":"Chou","sequence":"additional","affiliation":[{"name":"Division of Pulmonary and Critical Care Medicine, Department of Medicine Weill Cornell Medical College New York USA"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Carolina","family":"Szlufman","sequence":"additional","affiliation":[{"name":"Department of Clinical Nutrition New York\u2010Presbyterian Hospital\/Weill Cornell Medical Center New York USA"}],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Jane","family":"Ziegler","sequence":"additional","affiliation":[{"name":"Department of Clinical and Preventive Nutrition Sciences Rutgers University New Brunswick New Jersey USA"}],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"311","published-online":{"date-parts":[[2025,4,13]]},"reference":[{"key":"e_1_2_7_2_1","doi-asserted-by":"publisher","DOI":"10.1212\/WNL.0000000000012868"},{"key":"e_1_2_7_3_1","unstructured":"National Institute for Health and Care Excellence. Parkinson's disease in adults. Accessed June 2 2024.https:\/\/www.nice.org.uk\/guidance\/ng71\/resources\/parkinsons-disease-in-adults-pdf-1837629189061"},{"key":"e_1_2_7_4_1","doi-asserted-by":"publisher","DOI":"10.1503\/cmaj.181504"},{"key":"e_1_2_7_5_1","doi-asserted-by":"publisher","DOI":"10.1038\/s41531-023-00541-w"},{"key":"e_1_2_7_6_1","doi-asserted-by":"publisher","DOI":"10.1111\/ene.15734"},{"key":"e_1_2_7_7_1","doi-asserted-by":"publisher","D