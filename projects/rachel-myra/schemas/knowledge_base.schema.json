{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missing-label.local/schemas/knowledge_base.schema.json",
  "title": "The Missing Label knowledge base",
  "description": "One record per drug or class. Generated by scripts/build_knowledge_base.py. TypeScript mirror: lib/types/knowledge-base.ts. No dose numbers anywhere; claims with badge '?' have public=false.",
  "type": "object",
  "required": ["schema_version", "build_id", "disclaimer", "inputs", "evidence_model", "anticholinergic_scale", "combination_rules", "drugs"],
  "properties": {
    "schema_version": {"type": "string"},
    "build_id": {"type": "string"},
    "disclaimer": {"type": "string"},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "present"],
        "properties": {
          "path": {"type": "string"},
          "present": {"type": "boolean"},
          "rows": {"type": ["integer", "null"]},
          "sha1": {"type": ["string", "null"]}
        }
      }
    },
    "evidence_model": {
      "type": "object",
      "required": ["formula", "design_weights", "population_match", "meter_thresholds", "flag_change_rules"],
      "properties": {
        "formula": {"type": "string"},
        "design_weights": {"type": "object", "additionalProperties": {"type": "number"}},
        "population_match": {"type": "object", "additionalProperties": {"type": "number"}},
        "meter_thresholds": {"type": "object", "required": ["strong", "some"], "properties": {"strong": {"type": "number"}, "some": {"type": "number"}}},
        "flag_change_rules": {"type": "string"}
      }
    },
    "anticholinergic_scale": {
      "type": "object",
      "required": ["name", "source", "url", "input_file"],
      "properties": {"name": {"type": "string"}, "source": {"type": "string"}, "url": {"type": "string"}, "input_file": {"type": "string"}}
    },
    "combination_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "rule", "members", "description", "evidence", "claim_ids"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "rule": {"$ref": "#/$defs/combinationRule"},
          "members": {"type": "array", "items": {"type": "string"}},
          "description": {"type": "string"},
          "evidence": {"type": "string"},
          "claim_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "drugs": {"type": "array", "items": {"$ref": "#/$defs/drug"}}
  },
  "$defs": {
    "bucket": {"enum": ["adjust_dose", "hold_or_substitute", "monitor", "storage"]},
    "meter": {"enum": ["strong", "some", "early_signs"]},
    "level": {"enum": ["high", "moderate", "low"]},
    "direction": {"enum": ["supports_harm", "null", "conflicting", "protective", "plausible_untested", "evidence_gap"]},
    "badge": {"enum": ["✓✓", "✓", "↗", "⚠", "?"]},
    "badgeCode": {"enum": ["double_verified", "verified", "corroborated", "conflict", "unverified"]},
    "layer": {"enum": ["graph", "literature", "fda_reports", "label", "guidance"]},
    "combinationRule": {"enum": ["same_mechanism_stack", "cross_mechanism", "direct_evidence"]},
    "mechanismGroup": {"enum": ["sweat_blocked", "thermostat", "fluid_salt_loss", "low_sodium", "kidney_cleared_buildup", "kidney_stress", "faster_absorption", "sedation_awareness", "bp_drop", "heat_production", "blood_sugar", "storage_sensitive"]},
    "tier": {
      "type": "object",
      "required": ["code", "label"],
      "properties": {"code": {"type": "integer", "minimum": 1, "maximum": 8}, "label": {"type": "string"}}
    },
    "sourceRef": {
      "type": "object",
      "required": ["id", "label", "url"],
      "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "url": {"type": ["string", "null"]}}
    },
    "meterWithRationale": {
      "type": "object",
      "required": ["level", "plain_label", "rationale", "drivers"],
      "properties": {
        "level": {"$ref": "#/$defs/level"},
        "plain_label": {"type": "string"},
        "score": {"type": "number"},
        "rationale": {"type": "string"},
        "drivers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "heatStackEntry": {
      "type": "object",
      "required": ["affected", "how"],
      "properties": {"affected": {"enum": ["yes", "possible", "no"]}, "how": {"type": "string"}}
    },
    "claim": {
      "type": "object",
      "required": ["id", "text", "plain", "number", "source", "layer", "tier", "direction", "population", "badge", "badge_code", "verification", "citation_status", "public", "input_file"],
      "properties": {
        "id": {"type": "string"},
        "text": {"type": "string"},
        "plain": {"type": "string"},
        "number": {
          "type": ["object", "null"],
          "required": ["value", "type", "display", "plain"],
          "properties": {
            "value": {"type": "number"},
            "type": {"type": "string"},
            "ci_low": {"type": ["number", "null"]},
            "ci_high": {"type": ["number", "null"]},
            "display": {"type": "string"},
            "plain": {"type": "string"}
          }
        },
        "source": {"$ref": "#/$defs/sourceRef"},
        "layer": {"$ref": "#/$defs/layer"},
        "tier": {"oneOf": [{"$ref": "#/$defs/tier"}, {"type": "null"}]},
        "direction": {"$ref": "#/$defs/direction"},
        "population": {"type": "string"},
        "population_match": {"type": "string"},
        "badge": {"$ref": "#/$defs/badge"},
        "badge_code": {"$ref": "#/$defs/badgeCode"},
        "verification": {"type": "string"},
        "citation_status": {"type": "string"},
        "public": {"type": "boolean"},
        "input_file": {"type": "string"}
      },
      "if": {"properties": {"badge": {"const": "?"}}},
      "then": {"properties": {"public": {"const": false}}}
    },
    "patientMessage": {
      "type": "object",
      "required": ["situation", "en", "es", "es_status", "uses_claim_ids"],
      "properties": {
        "situation": {"enum": ["heat_forecast", "heat_day", "after_heat", "storage", "combined"]},
        "en": {"type": "string", "pattern": "Talk to your doctor or pharmacist\\.$"},
        "es": {"type": "string"},
        "es_status": {"const": "machine-translated, needs review"},
        "reading_level_note": {"type": "string"},
        "uses_claim_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "drug": {
      "type": "object",
      "required": ["id", "scope", "names", "buckets", "mechanism_groups", "label_line", "evidence", "flag", "change", "compass", "heat_stack", "prescribers", "higher_risk_groups", "guidance", "fda_label", "faers", "graph", "claims", "alternatives", "combinations", "timeline", "patient_messages", "storage", "gaps", "disclaimer"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "scope": {"enum": ["core15", "extra"]},
        "names": {
          "type": "object",
          "required": ["display", "plain", "class_label", "examples", "ingredients", "master_list_rows"],
          "properties": {
            "display": {"type": "string"},
            "plain": {"type": "string"},
            "class_label": {"type": "string"},
            "examples": {"type": "array", "items": {"type": "string"}},
            "ingredients": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "rxcui", "rxnorm_name", "tty", "acb_score"],
                "properties": {
                  "name": {"type": "string"},
                  "rxcui": {"type": ["string", "null"]},
                  "rxnorm_name": {"type": ["string", "null"]},
                  "tty": {"type": ["string", "null"]},
                  "acb_score": {"type": ["integer", "null"], "minimum": 1, "maximum": 3}
                }
              }
            },
            "master_list_rows": {"type": "array", "items": {"type": "string", "pattern": "^R\\d+$"}}
          }
        },
        "buckets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["bucket", "primary", "rationale"],
            "properties": {"bucket": {"$ref": "#/$defs/bucket"}, "primary": {"type": "boolean"}, "rationale": {"type": "string"}}
          }
        },
        "mechanism_groups": {"type": "array", "items": {"$ref": "#/$defs/mechanismGroup"}},
        "label_line": {"type": "string"},
        "evidence": {
          "type": "object",
          "required": ["meter", "meter_label", "tier", "literature_score", "components", "direction", "null_or_conflicting", "plain_summary"],
          "properties": {
            "meter": {"$ref": "#/$defs/meter"},
            "meter_label": {"enum": ["Strong", "Some", "Early signs"]},
            "tier": {"$ref": "#/$defs/tier"},
            "literature_score": {"type": "number", "minimum": 0, "maximum": 1},
            "components": {
              "type": "object",
              "required": ["design_weight", "independent_studies", "study_factor", "consistency", "population_match"],
              "properties": {
                "design_weight": {"type": "number"},
                "independent_studies": {"type": "integer"},
                "study_factor": {"type": "number"},
                "consistency": {"type": "number"},
                "population_match": {"type": "number"}
              }
            },
            "direction": {"$ref": "#/$defs/direction"},
            "null_or_conflicting": {"type": "array", "items": {"type": "string"}},
            "plain_summary": {"type": "string"}
          }
        },
        "flag": {"$ref": "#/$defs/meterWithRationale"},
        "change": {"$ref": "#/$defs/meterWithRationale"},
        "compass": {
          "type": "object",
          "required": ["arrow", "symbol", "meaning", "mechanism", "triggers", "monitor", "evidence_meter", "source_claim_ids", "note"],
          "properties": {
            "arrow": {"enum": ["up", "down", "depends"]},
            "symbol": {"enum": ["↑", "↓", "↕"]},
            "meaning": {"type": "string"},
            "mechanism": {"type": "string"},
            "triggers": {"type": "array", "items": {"type": "string"}},
            "monitor": {"type": "array", "items": {"type": "string"}},
            "evidence_meter": {"$ref": "#/$defs/meter"},
            "source_claim_ids": {"type": "array", "items": {"type": "string"}},
            "note": {"type": "string"}
          }
        },
        "heat_stack": {
          "type": "object",
          "required": ["sweating", "water_salt", "kidney_clearance", "blood_pressure", "other"],
          "properties": {
            "sweating": {"$ref": "#/$defs/heatStackEntry"},
            "water_salt": {"$ref": "#/$defs/heatStackEntry"},
            "kidney_clearance": {"$ref": "#/$defs/heatStackEntry"},
            "blood_pressure": {"$ref": "#/$defs/heatStackEntry"},
            "other": {"type": "array", "items": {"type": "object", "required": ["defense", "how"], "properties": {"defense": {"type": "string"}, "how": {"type": "string"}}}}
          }
        },
        "prescribers": {"type": "array", "items": {"type": "string"}},
        "higher_risk_groups": {"type": "array", "items": {"type": "string"}},
        "pediatric_note": {"type": ["string", "null"]},
        "guidance": {
          "type": "object",
          "required": ["n_jurisdictions", "jurisdictions_mentioning", "jurisdictions_specific_action", "gap", "gap_reason", "by_source", "input_file"],
          "properties": {
            "n_jurisdictions": {"type": "integer"},
            "jurisdictions_mentioning": {"type": "integer"},
            "jurisdictions_specific_action": {"type": "integer"},
            "gap": {"type": "boolean"},
            "gap_reason": {"type": "string"},
            "by_source": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["source_id", "jurisdiction", "mention_level", "action_type", "specific_action", "quote"],
                "properties": {
                  "source_id": {"type": "string"},
                  "jurisdiction": {"type": "string"},
                  "mention_level": {"enum": ["specific", "umbrella", "none"]},
                  "action_type": {"type": "string"},
                  "specific_action": {"type": "boolean"},
                  "evidence_cited": {"type": "boolean"},
                  "quote": {"type": "string"},
                  "location": {"type": "string"}
                }
              }
            },
            "input_file": {"type": "string"}
          }
        },
        "fda_label": {
          "type": "object",
          "required": ["class_status", "plain", "ingredients", "input_file"],
          "properties": {
            "class_status": {"enum": ["heat warning", "indirect only", "incidental or storage only", "not audited"]},
            "plain": {"type": "string"},
            "ingredients": {"type": "array", "items": {"type": "object", "required": ["ingredient", "best_tier", "n_labels_audited", "n_heat_warning"]}},
            "input_file": {"type": "string"}
          }
        },
        "faers": {
          "type": ["object", "null"],
          "required": ["composite", "headline", "rows", "neg_control_cutoff", "verdict", "plain", "caveat", "input_file"],
          "properties": {
            "verdict": {"enum": ["above negative-control band", "signal (within noise band)", "no signal"]},
            "caveat": {"const": "warning signal, not proof"}
          }
        },
        "graph": {
          "type": "object",
          "required": ["source", "pathways", "direct_findings", "untested_links", "validation_rank_nonbp", "api", "input_files"]
        },
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "why", "what_is_lost", "heat_studied", "heat_evidence_label", "source", "caution"],
            "properties": {
              "name": {"type": "string"},
              "why": {"type": "string"},
              "what_is_lost": {"type": "string"},
              "heat_studied": {"type": "boolean"},
              "heat_evidence_label": {"type": "string"},
              "source": {"oneOf": [{"$ref": "#/$defs/sourceRef"}, {"type": "null"}]},
              "caution": {"type": "string"}
            }
          }
        },
        "combinations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "partners", "label", "rule", "mechanism_groups", "finding", "direction", "claim_ids", "plain"],
            "properties": {
              "rule": {"$ref": "#/$defs/combinationRule"},
              "direction": {"$ref": "#/$defs/direction"},
              "mechanism_groups": {"type": "array", "items": {"$ref": "#/$defs/mechanismGroup"}}
            }
          }
        },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["phase", "action", "who", "evidence_meter", "basis"],
            "properties": {
              "phase": {"enum": ["before_summer", "72h_before", "during", "after"]},
              "action": {"type": "string"},
              "who": {"type": "array", "items": {"enum": ["prescriber", "pharmacist", "care_coordinator", "patient", "caregiver", "health_system"]}},
              "evidence_meter": {"$ref": "#/$defs/meter"},
              "basis": {"type": "string"}
            }
          }
        },
        "patient_messages": {"type": "array", "items": {"$ref": "#/$defs/patientMessage"}},
        "storage": {
          "type": ["object", "null"],
          "required": ["profile_id", "summary", "input_file"],
          "properties": {"profile_id": {"type": ["string", "null"]}, "summary": {"type": "string"}, "input_file": {"type": ["string", "null"]}}
        },
        "gaps": {"type": "array", "items": {"type": "string"}},
        "disclaimer": {"type": "string"}
      }
    }
  }
}
